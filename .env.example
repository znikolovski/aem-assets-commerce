# Default ACCS mode reuses the authorized Assets host IMS session.
# Configure only commerceUrl, storeCode and productsRoot in Extension Manager.
# No server credentials are needed if that session has Commerce API access.
#
# Optional ACCS service account when the host token lacks Commerce access:
# add a profile below and set connectionId=accs-service in Extension Manager.
# Client secrets belong only here, never in browser-visible configuration.
# ASSETS_COMMERCE_CONNECTIONS='{"accs-service":{"commerceType":"accs","authMode":"server","imsOrg":"YOUR_ORG@AdobeOrg","aemAuthorUrl":"https://author-p123-e456.adobeaemcloud.com","productsRoot":"/content/dam/products","commerceUrl":"https://na1-sandbox.api.commerce.adobe.com/YOUR_TENANT_ID","storeCodes":["default"],"commerceClientId":"YOUR_COMMERCE_OAUTH_CLIENT_ID","commerceClientSecret":"REPLACE_WITH_SERVER_ONLY_CLIENT_SECRET"}}'
#
# Legacy PaaS profiles remain supported with commerceType=paas and commerceToken.
ASSETS_COMMERCE_CONNECTIONS='{}'
