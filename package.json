{
  "name": "aem-assets-commerce",
  "version": "1.0.0",
  "private": true,
  "description": "Configurable AEM Assets View product-linking extension for Adobe Commerce",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "aio app build",
    "deploy": "aio app deploy",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint actions lib test web-src/src --ext .js"
  },
  "dependencies": {
    "@adobe/aio-lib-core-logging": "^3.0.2",
    "@adobe/react-spectrum": "3.47.7",
    "@adobe/uix-guest": "0.10.5",
    "@spectrum-icons/workflow": "3.2.5",
    "core-js": "^3.6.4",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "regenerator-runtime": "^0.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.8.7",
    "@babel/plugin-transform-react-jsx": "^7.8.3",
    "@babel/preset-env": "^7.8.7",
    "eslint": "^8.57.1",
    "eslint-plugin-jest": "^27.2.3",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^29.7.0",
    "react-test-renderer": "16.14.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["lib/**/*.js", "actions/**/*.js", "web-src/src/**/*.js"],
    "coveragePathIgnorePatterns": ["web-src/src/index.js", "web-src/src/config.json"]
  }
}
